# Price Intelligence Agent — secrets

# Structured-extraction LLM provider: 'gemini' (default) or 'openai'
LLM_PROVIDER=gemini

# --- OpenAI (used when LLM_PROVIDER=openai) ---
OPENAI_API_KEY=sk-your-openai-key-here
LLM_MODEL=gpt-4o-mini

# --- Google Gemini (used when LLM_PROVIDER=gemini) ---
GEMINI_API=your-gemini-api-key
# Comma-separated fallback chain; tried in order on 404/429/503
GEMINI_MODELS=gemini-3.6-flash,gemini-flash-latest,gemini-3.6-flash-lite,gemini-3.6-pro

# --- Tavily search (marketplace domains) ---
# Prefer TAVILY_API_KEY; the legacy TAVILY_API var is also honored.
TAVILY_API_KEY=tvly-your-tavily-key-here
# 'advanced' = longer snippets (better at finding prices); 'basic' = cheaper
TAVILY_DEPTH=advanced
# Results kept per marketplace (more = fuller market view)
TAVILY_MAX_RESULTS=8
# Dynamic mode scans up to N marketplaces, then keeps the top N by product-page hits
TAVILY_SCAN_MARKETPLACES=12
TAVILY_MAX_MARKETPLACES=6

# Action dispatcher. Empty = bundled local webhook receiver (WEBHOOK_PORT);
# a URL forwards approved actions to a real endpoint.
WEBHOOK_URL=
WEBHOOK_PORT=8504

# FX: LIVE_FX=1 uses live rates (open.er-api.com) with FIXED_RATES_PER_USD in
# schemas.py as offline fallback. Set LIVE_FX=0 to always use fixed rates.
LIVE_FX=1